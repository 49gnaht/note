 VAT_RATE = 0.08  # giảm VAT theo NQ 2024, hỏi kế toán trước khi đổi
 
+# Mã giảm giá: (loại, giá trị). "percent" = giảm %, "fixed" = giảm số tiền VND.
+COUPONS = {
+    "GIAM10": ("percent", 10),
+    "GIAM50K": ("fixed", 50000),
+}
+
 
 def calc_subtotal(order):
     total = 0
@@ -15,11 +21,26 @@ def calc_vat(amount):
     return int(round(amount * VAT_RATE))
 
 
+def calc_discount(order):
+    if order.coupon_code is None:
+        return 0
+    if order.coupon_code not in COUPONS:
+        raise ValueError(f"Mã giảm giá không hợp lệ: {order.coupon_code}")
+    kind, value = COUPONS[order.coupon_code]
+    sub = calc_subtotal(order)
+    if kind == "percent":
+        discount = int(round(sub * value / 100))
+    else:
+        discount = value
+    return min(discount, sub)
+
+
 def calc_total(order):
     subTotal = calc_subtotal(order)
-    vat = calc_vat(subTotal)
+    discount = calc_discount(order)
+    vat = calc_vat(subTotal - discount)
     ship = shipping_fee(order.province, subTotal)
-    return subTotal + vat + ship
+    return subTotal - discount + vat + ship
 
 
