@@ -0,0 +1,57 @@
+# Mã giảm giá cho đơn hàng. Đơn vị: VND (số nguyên).
+from dataclasses import dataclass
+from typing import Optional
+
+
+class InvalidDiscountCode(ValueError):
+    pass
+
+
+@dataclass(frozen=True)
+class DiscountCode:
+    code: str
+    kind: str  # "percent" hoặc "fixed"
+    value: int  # percent: 1-100; fixed: số tiền VND
+    min_subtotal: int = 0  # đơn tối thiểu để áp dụng
+    max_discount: Optional[int] = None  # trần giảm cho mã phần trăm
+
+    def __post_init__(self):
+        if self.kind not in ("percent", "fixed"):
+            raise ValueError(f"kind không hợp lệ: {self.kind}")
+        if self.kind == "percent" and not 0 < self.value <= 100:
+            raise ValueError("percent phải trong khoảng 1-100")
+        if self.kind == "fixed" and self.value <= 0:
+            raise ValueError("fixed phải > 0")
+
+
+# Danh sách mã đang chạy. Key viết hoa.
+CODES = {}
+
+
+def register_code(dc):
+    CODES[dc.code.upper()] = dc
+
+
+def get_code(code):
+    dc = CODES.get(code.strip().upper())
+    if dc is None:
+        raise InvalidDiscountCode(f"Mã giảm giá không tồn tại: {code}")
+    return dc
+
+
+def calc_discount(code, subtotal):
+    """Số tiền được giảm (không vượt quá subtotal). code=None -> 0."""
+    if not code:
+        return 0
+    dc = get_code(code)
+    if subtotal < dc.min_subtotal:
+        raise InvalidDiscountCode(
+            f"Mã {dc.code} chỉ áp dụng cho đơn từ {dc.min_subtotal}đ"
+        )
+    if dc.kind == "percent":
+        amount = int(round(subtotal * dc.value / 100))
+        if dc.max_discount is not None:
+            amount = min(amount, dc.max_discount)
+    else:
+        amount = dc.value
+    return min(amount, subtotal)
