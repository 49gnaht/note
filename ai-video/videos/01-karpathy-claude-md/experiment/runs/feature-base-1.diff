diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..e4510d0
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,72 @@
+import pytest
+
+from shop import discount
+from shop.discount import DiscountCode, InvalidDiscountCode, calc_discount, register_code
+from shop.models import Order, OrderItem
+from shop.pricing import calc_total
+from shop.invoice import render_invoice
+
+
+@pytest.fixture(autouse=True)
+def codes(monkeypatch):
+    monkeypatch.setattr(discount, "CODES", {})
+    register_code(DiscountCode("GIAM10", "percent", 10))
+    register_code(DiscountCode("GIAM50", "percent", 50, max_discount=100000))
+    register_code(DiscountCode("TRU50K", "fixed", 50000, min_subtotal=300000))
+
+
+def order(price, qty=1, code=None, province="HN"):
+    return Order("DH009", "Lê Văn C", province, [OrderItem("SP1", "Áo", price, qty)], code)
+
+
+def test_no_code():
+    assert calc_discount(None, 200000) == 0
+
+
+def test_percent_and_case_insensitive():
+    assert calc_discount(" giam10 ", 200000) == 20000
+
+
+def test_percent_capped():
+    assert calc_discount("GIAM50", 600000) == 100000
+
+
+def test_fixed_requires_min_subtotal():
+    assert calc_discount("TRU50K", 300000) == 50000
+    with pytest.raises(InvalidDiscountCode):
+        calc_discount("TRU50K", 299999)
+
+
+def test_discount_never_exceeds_subtotal():
+    register_code(DiscountCode("TRU1TR", "fixed", 1000000))
+    assert calc_discount("TRU1TR", 200000) == 200000
+
+
+def test_unknown_code():
+    with pytest.raises(InvalidDiscountCode):
+        calc_discount("KHONGCO", 200000)
+
+
+def test_invalid_definition():
+    with pytest.raises(ValueError):
+        DiscountCode("X", "percent", 150)
+
+
+def test_total_vat_after_discount():
+    # 200k - 10% = 180k; VAT 8% = 14.4k; ship HN 20k
+    assert calc_total(order(200000, code="GIAM10")) == 180000 + 14400 + 20000
+
+
+def test_discount_can_drop_below_free_ship_threshold():
+    # 550k -> giảm 55k còn 495k: mất free ship
+    assert calc_total(order(550000, code="GIAM10")) == 495000 + 39600 + 20000
+
+
+def test_invoice_shows_discount():
+    out = render_invoice(order(200000, code="giam10"))
+    assert "Giảm giá (GIAM10): -20.000đ" in out
+    assert "TỔNG: 214.400đ" in out
+
+
+def test_invoice_without_code_has_no_discount_line():
+    assert "Giảm giá" not in render_invoice(order(200000))
