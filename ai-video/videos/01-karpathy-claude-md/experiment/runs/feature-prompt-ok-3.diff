@@ -0,0 +1,93 @@
+from datetime import date
+
+import pytest
+
+from shop import coupons
+from shop.coupons import Coupon, InvalidCouponError, calc_discount
+from shop.invoice import render_invoice
+from shop.models import Order, OrderItem
+from shop.pricing import calc_breakdown, calc_total
+
+TODAY = date(2026, 11, 21)
+
+
+@pytest.fixture(autouse=True)
+def fake_coupons(monkeypatch):
+    monkeypatch.setattr(coupons, "COUPONS", {
+        c.code: c for c in [
+            Coupon("PCT10", "percent", 10, max_discount=50000, min_subtotal=200000),
+            Coupon("FIX50K", "fixed", 50000, min_subtotal=300000),
+            Coupon("FIX1M", "fixed", 1000000),
+            Coupon("OLD", "percent", 10, expires_on=date(2026, 11, 20)),
+            Coupon("LASTDAY", "percent", 10, expires_on=TODAY),
+        ]
+    })
+
+
+def make_order(price=100000, qty=2, province="HN", code=None):
+    return Order("DH001", "Nguyễn Văn A", province, [OrderItem("SP1", "Áo thun", price, qty)], code)
+
+
+def test_no_coupon():
+    assert calc_discount(None, 200000, TODAY) == 0
+
+
+def test_percent():
+    assert calc_discount("PCT10", 200000, TODAY) == 20000
+
+
+def test_percent_capped():
+    assert calc_discount("PCT10", 1000000, TODAY) == 50000
+
+
+def test_fixed():
+    assert calc_discount("FIX50K", 300000, TODAY) == 50000
+
+
+def test_discount_never_exceeds_subtotal():
+    assert calc_discount("FIX1M", 200000, TODAY) == 200000
+
+
+def test_code_case_insensitive():
+    assert calc_discount(" pct10 ", 200000, TODAY) == 20000
+
+
+def test_unknown_code():
+    with pytest.raises(InvalidCouponError, match="không tồn tại"):
+        calc_discount("NOPE", 200000, TODAY)
+
+
+def test_expired():
+    with pytest.raises(InvalidCouponError, match="hết hạn"):
+        calc_discount("OLD", 200000, TODAY)
+
+
+def test_valid_on_expiry_day():
+    assert calc_discount("LASTDAY", 200000, TODAY) == 20000
+
+
+def test_below_min_subtotal():
+    with pytest.raises(InvalidCouponError, match="200.000đ"):
+        calc_discount("PCT10", 199999, TODAY)
+
+
+def test_vat_on_discounted_amount():
+    b = calc_breakdown(make_order(code="PCT10"), TODAY)
+    assert (b.subtotal, b.discount, b.vat, b.ship) == (200000, 20000, 14400, 20000)
+    assert b.total == 180000 + 14400 + 20000
+
+
+def test_free_ship_threshold_uses_discounted_amount():
+    # 520k - 50k = 470k -> không còn được miễn ship
+    o = make_order(price=260000, qty=2, code="FIX50K")
+    assert calc_total(o, TODAY) == 470000 + 37600 + 20000
+
+
+def test_invoice_shows_discount_line():
+    out = render_invoice(make_order(code="pct10"), TODAY)
+    assert "Giảm giá (PCT10): -20.000đ" in out
+    assert "TỔNG: 214.400đ" in out
+
+
+def test_invoice_without_coupon_has_no_discount_line():
+    assert "Giảm giá" not in render_invoice(make_order(), TODAY)
