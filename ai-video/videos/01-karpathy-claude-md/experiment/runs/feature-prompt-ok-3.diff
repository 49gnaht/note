+# Mã giảm giá. Mỗi đơn dùng tối đa 1 mã, giảm trên tạm tính (trước VAT).
+from dataclasses import dataclass
+from datetime import date
+
+
+class InvalidCouponError(ValueError):
+    """Mã không dùng được; message là lý do để hiển thị cho khách."""
+
+
+@dataclass(frozen=True)
+class Coupon:
+    code: str
+    kind: str  # "percent" | "fixed"
+    value: int  # percent: số % (vd 10); fixed: số tiền VND
+    max_discount: int | None = None  # trần giảm cho loại percent
+    min_subtotal: int = 0  # tạm tính tối thiểu để dùng mã
+    expires_on: date | None = None  # ngày cuối cùng còn dùng được (tính cả ngày này)
+
+
+# Danh sách mã. Các mã dưới đây là VÍ DỤ, thay bằng mã thật trước khi chạy production.
+COUPONS = {
+    c.code: c
+    for c in [
+        Coupon("GIAM10", "percent", 10, max_discount=50000, min_subtotal=200000),
+        Coupon("GIAM50K", "fixed", 50000, min_subtotal=300000),
+    ]
+}
+
+
+def find_coupon(code):
+    coupon = COUPONS.get(code.strip().upper())
+    if coupon is None:
+        raise InvalidCouponError(f"Mã giảm giá {code} không tồn tại")
+    return coupon
+
+
+def calc_discount(code, subtotal, today=None):
+    """Số tiền giảm (VND, số nguyên, không vượt quá tạm tính). code=None -> 0."""
+    if not code:
+        return 0
+    coupon = find_coupon(code)
+    today = today or date.today()
+    if coupon.expires_on is not None and today > coupon.expires_on:
+        raise InvalidCouponError(f"Mã giảm giá {coupon.code} đã hết hạn")
+    if subtotal < coupon.min_subtotal:
+        raise InvalidCouponError(
+            f"Mã giảm giá {coupon.code} chỉ áp dụng cho đơn từ {coupon.min_subtotal:,}đ".replace(",", ".")
+        )
+
+    if coupon.kind == "percent":
+        discount = int(round(subtotal * coupon.value / 100))
+        if coupon.max_discount is not None:
+            discount = min(discount, coupon.max_discount)
+    elif coupon.kind == "fixed":
+        discount = coupon.value
+    else:
+        raise ValueError(f"Loại mã không hợp lệ: {coupon.kind}")
+    return min(discount, subtotal)
