+def calc_breakdown(order, today=None):
+    # Giảm giá trừ vào tạm tính trước; VAT và ngưỡng miễn ship tính trên số sau giảm.
+    subtotal = calc_subtotal(order)
+    discount = calc_discount(order.coupon_code, subtotal, today)
+    taxable = subtotal - discount
+    return Breakdown(
+        subtotal=subtotal,
+        discount=discount,
+        vat=calc_vat(taxable),
+        ship=shipping_fee(order.province, taxable),
+    )
+
+
+def calc_total(order, today=None):
+    return calc_breakdown(order, today).total
 
 
