diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..881ea8d
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,67 @@
+import pytest
+
+from shop.discount import Coupon, calc_discount, PERCENT, FIXED
+from shop.invoice import render_invoice
+from shop.models import Order, OrderItem
+from shop.pricing import calc_total
+
+
+def make_order(price=100000, qty=2, coupon=None, province="HN"):
+    return Order("DH003", "Lê Văn C", province, [OrderItem("SP1", "Áo thun", price, qty)], coupon)
+
+
+def test_no_coupon():
+    assert calc_discount(None, 200000) == 0
+
+
+def test_percent():
+    assert calc_discount(Coupon("SALE10", PERCENT, 10), 200000) == 20000
+
+
+def test_fixed():
+    assert calc_discount(Coupon("GIAM50K", FIXED, 50000), 200000) == 50000
+
+
+def test_percent_capped_by_max_discount():
+    c = Coupon("SALE50", PERCENT, 50, max_discount=30000)
+    assert calc_discount(c, 200000) == 30000
+
+
+def test_below_min_subtotal_not_applied():
+    c = Coupon("GIAM50K", FIXED, 50000, min_subtotal=300000)
+    assert calc_discount(c, 200000) == 0
+    assert calc_discount(c, 300000) == 50000
+
+
+def test_discount_never_exceeds_subtotal():
+    assert calc_discount(Coupon("BIG", FIXED, 500000), 200000) == 200000
+
+
+@pytest.mark.parametrize("kind,value", [("bogus", 10), (PERCENT, 101), (FIXED, -1)])
+def test_invalid_coupon(kind, value):
+    with pytest.raises(ValueError):
+        Coupon("X", kind, value)
+
+
+def test_total_discount_applied_before_vat():
+    # 200.000 - 20.000 = 180.000; VAT 8% = 14.400; ship HN 20.000
+    o = make_order(coupon=Coupon("SALE10", PERCENT, 10))
+    assert calc_total(o) == 180000 + 14400 + 20000
+
+
+def test_free_ship_uses_discounted_subtotal():
+    # 600.000 - 200.000 = 400.000 -> không còn được miễn ship
+    o = make_order(price=300000, qty=2, coupon=Coupon("GIAM200K", FIXED, 200000))
+    assert calc_total(o) == 400000 + 32000 + 20000
+
+
+def test_invoice_shows_discount_line():
+    o = make_order(coupon=Coupon("SALE10", PERCENT, 10))
+    out = render_invoice(o)
+    assert "Giảm giá (SALE10): -20.000đ" in out
+    assert "VAT: 14.400đ" in out
+    assert "TỔNG: 214.400đ" in out
+
+
+def test_invoice_without_coupon_has_no_discount_line():
+    assert "Giảm giá" not in render_invoice(make_order())
