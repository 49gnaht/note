+# Mã giảm giá cho đơn hàng. Đơn vị: VND (số nguyên).
+from dataclasses import dataclass
+from typing import Optional
+
+PERCENT = "percent"
+FIXED = "fixed"
+
+
+@dataclass
+class Coupon:
+    code: str
+    kind: str  # PERCENT (value = % giảm, 0-100) hoặc FIXED (value = số tiền giảm)
+    value: int
+    min_subtotal: int = 0  # đơn tối thiểu để áp dụng mã
+    max_discount: Optional[int] = None  # trần giảm tối đa (thường dùng cho mã %)
+
+    def __post_init__(self):
+        if self.kind not in (PERCENT, FIXED):
+            raise ValueError(f"Loại mã không hợp lệ: {self.kind!r}")
+        if self.value < 0:
+            raise ValueError("Giá trị giảm không được âm")
+        if self.kind == PERCENT and self.value > 100:
+            raise ValueError("Mã % không được vượt quá 100")
+
+
+def calc_discount(coupon, subtotal):
+    """Số tiền được giảm trên tạm tính. Trả 0 nếu không có mã hoặc chưa đủ điều kiện."""
+    if coupon is None or subtotal < coupon.min_subtotal:
+        return 0
+    if coupon.kind == PERCENT:
+        amount = int(round(subtotal * coupon.value / 100))
+    else:
+        amount = coupon.value
+    if coupon.max_discount is not None:
+        amount = min(amount, coupon.max_discount)
+    return min(amount, subtotal)  # không giảm quá giá trị đơn
