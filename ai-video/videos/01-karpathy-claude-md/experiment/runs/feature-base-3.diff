+def calc_discount(order):
+    coupon = getattr(order, "coupon", None)
+    if coupon is None:
+        return 0
+    return coupon.discount_for(calc_subtotal(order))
+
+
+def calc_taxable(order):
+    """Tạm tính sau giảm giá; VAT và ngưỡng miễn ship tính trên số này."""
+    return calc_subtotal(order) - calc_discount(order)
+
+
