@@ -0,0 +1,76 @@
+import pytest
+
+from shop.coupon import Coupon, CouponError, FIXED, PERCENT, apply_coupon
+from shop.invoice import render_invoice
+from shop.models import Order, OrderItem
+from shop.pricing import calc_discount, calc_total
+
+
+def make_order(province="HN", price=100000, qty=2, coupon=None):
+    return Order("DH001", "Nguyễn Văn A", province,
+                 [OrderItem("SP1", "Áo thun", price, qty)], coupon)
+
+
+def test_no_coupon_unchanged():
+    assert calc_discount(make_order()) == 0
+    assert calc_total(make_order()) == 200000 + 16000 + 20000
+
+
+def test_percent_coupon():
+    o = make_order(coupon=Coupon("GIAM10", PERCENT, 10))
+    assert calc_discount(o) == 20000
+    # VAT tính trên 180.000 sau giảm
+    assert calc_total(o) == 180000 + 14400 + 20000
+
+
+def test_percent_coupon_capped():
+    o = make_order(price=1000000, qty=1, coupon=Coupon("GIAM50", PERCENT, 50, max_discount=100000))
+    assert calc_discount(o) == 100000
+
+
+def test_fixed_coupon():
+    o = make_order(coupon=Coupon("TRU50K", FIXED, 50000))
+    assert calc_total(o) == 150000 + 12000 + 20000
+
+
+def test_fixed_coupon_not_exceed_subtotal():
+    o = make_order(price=10000, qty=1, coupon=Coupon("TRU50K", FIXED, 50000))
+    assert calc_discount(o) == 10000
+    assert calc_total(o) == 0 + 0 + 20000
+
+
+def test_discount_can_drop_below_free_ship_threshold():
+    o = make_order(price=300000, qty=2, coupon=Coupon("TRU200K", FIXED, 200000))
+    assert calc_total(o) == 400000 + 32000 + 20000
+
+
+def test_min_subtotal_not_met_gives_no_discount():
+    o = make_order(coupon=Coupon("VIP", FIXED, 50000, min_subtotal=300000))
+    assert calc_discount(o) == 0
+
+
+def test_apply_coupon_rejects_ineligible_order():
+    with pytest.raises(CouponError):
+        apply_coupon(make_order(), Coupon("VIP", FIXED, 50000, min_subtotal=300000))
+
+
+def test_apply_coupon_ok():
+    o = apply_coupon(make_order(), Coupon("GIAM10", PERCENT, 10))
+    assert o.coupon.code == "GIAM10"
+
+
+@pytest.mark.parametrize("kind,value", [("bogus", 10), (PERCENT, 0), (PERCENT, 101), (FIXED, -1)])
+def test_invalid_coupon(kind, value):
+    with pytest.raises(CouponError):
+        Coupon("X", kind, value)
+
+
+def test_invoice_shows_discount():
+    out = render_invoice(make_order(coupon=Coupon("GIAM10", PERCENT, 10)))
+    assert "Giảm giá (GIAM10): -20.000đ" in out
+    assert "VAT: 14.400đ" in out
+    assert "TỔNG: 214.400đ" in out
+
+
+def test_invoice_without_coupon_has_no_discount_line():
+    assert "Giảm giá" not in render_invoice(make_order())
