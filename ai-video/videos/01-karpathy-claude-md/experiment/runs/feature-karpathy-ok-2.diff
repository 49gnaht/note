diff --git a/tests/test_pricing.py b/tests/test_pricing.py
index 5738dd4..3ac1ad7 100644
--- a/tests/test_pricing.py
+++ b/tests/test_pricing.py
@@ -1,3 +1,5 @@
+import pytest
+
 from shop.models import Order, OrderItem
 from shop.pricing import calc_subtotal, calc_vat, calc_total
 
@@ -20,3 +22,34 @@ def test_total_with_ship():
 
 def test_total_free_ship():
     assert calc_total(make_order(price=300000, qty=2)) == 600000 + 48000
+
+
+def make_discount_order(code, price=100000, qty=2):
+    o = make_order(price=price, qty=qty)
+    o.discount_code = code
+    return o
+
+
+def test_discount_percent():
+    # 200.000 - 10% = 180.000; VAT 8% trên 180.000 = 14.400; ship HN 20.000
+    assert calc_total(make_discount_order("GIAM10")) == 180000 + 14400 + 20000
+
+
+def test_discount_fixed():
+    # 200.000 - 50.000 = 150.000; VAT 12.000; ship 20.000
+    assert calc_total(make_discount_order("GIAM50K")) == 150000 + 12000 + 20000
+
+
+def test_discount_fixed_capped_at_subtotal():
+    # Đơn 30.000 dùng mã 50.000 -> chỉ giảm 30.000, không âm
+    assert calc_total(make_discount_order("GIAM50K", price=30000, qty=1)) == 0 + 0 + 20000
+
+
+def test_free_ship_threshold_uses_original_subtotal():
+    # 600.000 - 50.000 = 550.000; vẫn miễn ship vì tạm tính gốc 600.000 > 500.000
+    assert calc_total(make_discount_order("GIAM50K", price=300000, qty=2)) == 550000 + 44000
+
+
+def test_invalid_discount_code():
+    with pytest.raises(ValueError):
+        calc_total(make_discount_order("KHONGCO"))
