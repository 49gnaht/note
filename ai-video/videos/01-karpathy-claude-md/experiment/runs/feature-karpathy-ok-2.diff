 VAT_RATE = 0.08  # giảm VAT theo NQ 2024, hỏi kế toán trước khi đổi
 
+# Mã giảm giá: (loại, giá trị). "percent" = giảm %, "fixed" = giảm số tiền VND.
+DISCOUNT_CODES = {
+    "GIAM10": ("percent", 10),
+    "GIAM50K": ("fixed", 50000),
+}
+
 
 def calc_subtotal(order):
     total = 0
@@ -15,11 +21,23 @@ def calc_vat(amount):
     return int(round(amount * VAT_RATE))
 
 
+def calc_discount(order, subtotal):
+    if not order.discount_code:
+        return 0
+    if order.discount_code not in DISCOUNT_CODES:
+        raise ValueError(f"Mã giảm giá không hợp lệ: {order.discount_code}")
+    kind, value = DISCOUNT_CODES[order.discount_code]
+    if kind == "percent":
+        return int(round(subtotal * value / 100))
+    return min(value, subtotal)
+
+
 def calc_total(order):
     subTotal = calc_subtotal(order)
-    vat = calc_vat(subTotal)
+    discount = calc_discount(order, subTotal)
+    vat = calc_vat(subTotal - discount)
     ship = shipping_fee(order.province, subTotal)
-    return subTotal + vat + ship
+    return subTotal - discount + vat + ship
 
 
