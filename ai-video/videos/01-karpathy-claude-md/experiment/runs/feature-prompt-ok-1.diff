diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..a0e1b09
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,139 @@
+from datetime import date
+
+import pytest
+
+from shop.discount import FIXED, PERCENT, DiscountCode, DiscountError, apply_code
+from shop.invoice import render_invoice
+from shop.models import Order, OrderItem
+from shop.pricing import calc_breakdown, calc_total, old_calc_total_v1
+
+TODAY = date(2026, 11, 21)
+
+CODES = [
+    DiscountCode("SALE10", PERCENT, 10, max_discount=50000),
+    DiscountCode("GIAM50K", FIXED, 50000, min_order=300000),
+    DiscountCode("BIG", FIXED, 10_000_000),
+    DiscountCode("OLD", PERCENT, 20, expires_on=date(2026, 11, 20)),
+    DiscountCode("LASTDAY", PERCENT, 20, expires_on=TODAY),
+]
+
+
+def make_order(province="HN", price=100000, qty=2):
+    return Order("DH001", "Nguyễn Văn A", province, [OrderItem("SP1", "Áo thun", price, qty)])
+
+
+def test_no_code_unchanged():
+    assert calc_total(make_order()) == 200000 + 16000 + 20000
+
+
+def test_percent_discount_before_vat():
+    o = make_order()  # 200.000
+    apply_code(o, "SALE10", CODES, TODAY)
+    b = calc_breakdown(o)
+    assert b["discount"] == 20000
+    assert b["vat"] == 14400  # 8% của 180.000
+    assert b["total"] == 180000 + 14400 + 20000
+
+
+def test_percent_capped_by_max_discount():
+    o = make_order(price=1000000, qty=1)  # 10% = 100.000, trần 50.000
+    apply_code(o, "SALE10", CODES, TODAY)
+    assert calc_breakdown(o)["discount"] == 50000
+
+
+def test_fixed_discount():
+    o = make_order(price=300000, qty=1)
+    apply_code(o, "GIAM50K", CODES, TODAY)
+    assert calc_total(o) == 250000 + 20000 + 20000
+
+
+def test_discount_never_exceeds_subtotal():
+    o = make_order()
+    apply_code(o, "BIG", CODES, TODAY)
+    b = calc_breakdown(o)
+    assert b["discount"] == 200000
+    assert b["vat"] == 0
+    assert b["total"] == 20000  # chỉ còn phí ship
+
+
+def test_free_ship_threshold_uses_discounted_amount():
+    o = make_order(price=300000, qty=2)  # 600.000 -> miễn ship nếu không có mã
+    apply_code(o, "BIG", CODES, TODAY)
+    assert calc_breakdown(o)["ship"] == 20000
+    o2 = make_order(price=550000, qty=1)
+    apply_code(o2, "SALE10", CODES, TODAY)  # 550.000 - 50.000 = 500.000, không > 500.000
+    assert calc_breakdown(o2)["ship"] == 20000
+
+
+def test_code_is_case_insensitive():
+    o = make_order()
+    apply_code(o, "  sale10 ", CODES, TODAY)
+    assert o.discount.code == "SALE10"
+
+
+def test_unknown_code():
+    with pytest.raises(DiscountError, match="không tồn tại"):
+        apply_code(make_order(), "NOPE", CODES, TODAY)
+
+
+def test_expired_code():
+    with pytest.raises(DiscountError, match="hết hạn"):
+        apply_code(make_order(), "OLD", CODES, TODAY)
+
+
+def test_code_valid_on_expiry_day():
+    o = make_order()
+    apply_code(o, "LASTDAY", CODES, TODAY)
+    assert calc_breakdown(o)["discount"] == 40000
+
+
+def test_min_order_not_met():
+    o = make_order()
+    with pytest.raises(DiscountError, match="300.000đ"):
+        apply_code(o, "GIAM50K", CODES, TODAY)
+    assert o.discount is None
+
+
+def test_min_order_rechecked_if_order_shrinks():
+    o = make_order(price=300000, qty=1)
+    apply_code(o, "GIAM50K", CODES, TODAY)
+    o.items[0].qty = 0
+    o.items.append(OrderItem("SP2", "Tất", 10000, 1))
+    with pytest.raises(DiscountError):
+        calc_total(o)
+
+
+def test_only_one_code_per_order():
+    o = make_order()
+    apply_code(o, "SALE10", CODES, TODAY)
+    apply_code(o, "BIG", CODES, TODAY)
+    assert o.discount.code == "BIG"
+
+
+def test_invalid_code_definitions():
+    with pytest.raises(ValueError):
+        DiscountCode("X", PERCENT, 150)
+    with pytest.raises(ValueError):
+        DiscountCode("X", FIXED, 0)
+    with pytest.raises(ValueError):
+        DiscountCode("X", "bogus", 10)
+
+
+def test_invoice_shows_discount_line():
+    o = make_order()
+    apply_code(o, "SALE10", CODES, TODAY)
+    out = render_invoice(o)
+    assert "Giảm giá (SALE10): -20.000đ" in out
+    assert "VAT: 14.400đ" in out
+    assert "TỔNG: 214.400đ" in out
+
+
+def test_invoice_without_discount_has_no_discount_line():
+    assert "Giảm giá" not in render_invoice(make_order())
+
+
+def test_old_v1_ignores_discount():
+    o = make_order()
+    before = old_calc_total_v1(o)
+    apply_code(o, "SALE10", CODES, TODAY)
+    assert old_calc_total_v1(o) == before
