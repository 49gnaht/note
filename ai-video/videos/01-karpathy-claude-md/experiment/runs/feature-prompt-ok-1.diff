 # Tính tiền đơn hàng. Đơn vị: VND (số nguyên).
+from shop.discount import discount_amount
 from shop.shipping import shipping_fee
 
 VAT_RATE = 0.08  # giảm VAT theo NQ 2024, hỏi kế toán trước khi đổi
@@ -15,11 +16,24 @@ def calc_vat(amount):
     return int(round(amount * VAT_RATE))
 
 
+def calc_breakdown(order):
+    """Chi tiết tiền của đơn. Giảm giá trừ trước VAT; VAT và ship tính trên tiền sau giảm."""
+    subtotal = calc_subtotal(order)
+    discount = discount_amount(order.discount, subtotal)
+    taxable = subtotal - discount
+    vat = calc_vat(taxable)
+    ship = shipping_fee(order.province, taxable)
+    return {
+        "subtotal": subtotal,
+        "discount": discount,
+        "vat": vat,
+        "ship": ship,
+        "total": taxable + vat + ship,
+    }
+
+
 def calc_total(order):
-    subTotal = calc_subtotal(order)
-    vat = calc_vat(subTotal)
-    ship = shipping_fee(order.province, subTotal)
-    return subTotal + vat + ship
+    return calc_breakdown(order)["total"]
 
 
