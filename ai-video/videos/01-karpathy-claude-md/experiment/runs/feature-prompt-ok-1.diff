+++ b/shop/discount.py
@@ -0,0 +1,84 @@
+# Mã giảm giá cho đơn hàng. Đơn vị: VND (số nguyên).
+#
+# Quy tắc:
+# - Mỗi đơn dùng tối đa 1 mã, áp dụng cho cả đơn.
+# - Giảm trừ vào tạm tính TRƯỚC VAT; VAT và ngưỡng miễn ship tính trên số tiền sau giảm.
+# - Số tiền giảm không bao giờ vượt quá tạm tính.
+from dataclasses import dataclass
+from datetime import date
+
+PERCENT = "percent"
+FIXED = "fixed"
+
+
+class DiscountError(ValueError):
+    """Mã không tồn tại hoặc không đủ điều kiện áp dụng."""
+
+
+@dataclass(frozen=True)
+class DiscountCode:
+    code: str
+    kind: str                       # PERCENT hoặc FIXED
+    value: int                      # % (1-100) nếu PERCENT, số tiền VND nếu FIXED
+    max_discount: int | None = None  # mức giảm tối đa (chỉ dùng cho PERCENT)
+    min_order: int = 0              # giá trị tạm tính tối thiểu
+    expires_on: date | None = None  # còn dùng được hết ngày này
+
+    def __post_init__(self):
+        if self.kind not in (PERCENT, FIXED):
+            raise ValueError(f"Loại mã không hợp lệ: {self.kind}")
+        if self.kind == PERCENT and not 0 < self.value <= 100:
+            raise ValueError("Mã % phải có giá trị từ 1 đến 100")
+        if self.kind == FIXED and self.value <= 0:
+            raise ValueError("Mã giảm tiền phải có giá trị dương")
+
+
+def normalize(code):
+    return code.strip().upper()
+
+
+def find_code(code, codes):
+    """Tìm mã (không phân biệt hoa/thường) trong danh sách `codes`."""
+    key = normalize(code)
+    for dc in codes:
+        if normalize(dc.code) == key:
+            return dc
+    raise DiscountError(f"Mã giảm giá {code!r} không tồn tại")
+
+
+def _check_min_order(dc, subtotal):
+    if subtotal < dc.min_order:
+        raise DiscountError(
+            f"Mã {dc.code} chỉ áp dụng cho đơn từ {dc.min_order:,}đ".replace(",", ".")
+        )
+
+
+def check_eligible(dc, subtotal, today=None):
+    today = today or date.today()
+    if dc.expires_on is not None and today > dc.expires_on:
+        raise DiscountError(f"Mã {dc.code} đã hết hạn ngày {dc.expires_on:%d/%m/%Y}")
+    _check_min_order(dc, subtotal)
+
+
+def discount_amount(dc, subtotal):
+    """Số tiền được giảm cho tạm tính `subtotal`. Hạn dùng đã kiểm tra lúc apply_code."""
+    if dc is None:
+        return 0
+    _check_min_order(dc, subtotal)  # đơn có thể bị sửa sau khi gắn mã
+    if dc.kind == PERCENT:
+        amount = subtotal * dc.value // 100  # làm tròn xuống
+        if dc.max_discount is not None:
+            amount = min(amount, dc.max_discount)
+    else:
+        amount = dc.value
+    return min(amount, subtotal)
+
+
+def apply_code(order, code, codes, today=None):
+    """Kiểm tra mã và gắn vào đơn. Ghi đè mã cũ nếu có (1 đơn tối đa 1 mã)."""
+    from shop.pricing import calc_subtotal
+
+    dc = find_code(code, codes)
+    check_eligible(dc, calc_subtotal(order), today)
+    order.discount = dc
+    return dc
