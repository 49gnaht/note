+# Mã giảm giá. Đơn vị: VND (số nguyên).
+from dataclasses import dataclass
+from datetime import date
+
+PERCENT = "percent"
+FIXED = "fixed"
+
+
+@dataclass
+class Coupon:
+    code: str
+    kind: str  # PERCENT hoặc FIXED
+    value: int  # % (vd 10) hoặc số tiền VND
+    max_discount: int | None = None  # trần giảm cho loại PERCENT
+    min_order: int = 0  # tạm tính tối thiểu (trước giảm)
+    expires: date | None = None  # còn hiệu lực hết ngày này
+
+
+# Danh sách mã đang chạy. Tạm thời khai báo tại đây (chưa có DB).
+COUPONS: dict[str, Coupon] = {}
+
+
+def find_coupon(code, coupons=None):
+    coupons = COUPONS if coupons is None else coupons
+    key = code.strip().upper()
+    if key not in coupons:
+        raise ValueError(f"Mã giảm giá không tồn tại: {code}")
+    return coupons[key]
+
+
+def calc_discount(code, subtotal, today=None, coupons=None):
+    """Số tiền được giảm cho tạm tính `subtotal`. Không có mã -> 0.
+
+    Mã sai / hết hạn / chưa đủ đơn tối thiểu -> ValueError.
+    """
+    if not code:
+        return 0
+    c = find_coupon(code, coupons)
+    today = today or date.today()
+    if c.expires is not None and today > c.expires:
+        raise ValueError(f"Mã giảm giá đã hết hạn: {c.code}")
+    if subtotal < c.min_order:
+        raise ValueError(f"Đơn chưa đạt tối thiểu {c.min_order}đ để dùng mã {c.code}")
+
+    if c.kind == PERCENT:
+        disc = int(round(subtotal * c.value / 100))
+        if c.max_discount is not None:
+            disc = min(disc, c.max_discount)
+    elif c.kind == FIXED:
+        disc = c.value
+    else:
+        raise ValueError(f"Loại mã không hợp lệ: {c.kind}")
+    return min(disc, subtotal)
