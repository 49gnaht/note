diff --git a/tests/test_coupons.py b/tests/test_coupons.py
new file mode 100644
index 0000000..7b52048
--- /dev/null
+++ b/tests/test_coupons.py
@@ -0,0 +1,97 @@
+from datetime import date
+
+import pytest
+
+from shop import coupons
+from shop.coupons import Coupon, PERCENT, FIXED, calc_discount
+from shop.models import Order, OrderItem
+from shop.pricing import calc_total
+from shop.invoice import render_invoice
+
+TODAY = date(2026, 11, 21)
+
+
+@pytest.fixture(autouse=True)
+def sample_coupons(monkeypatch):
+    monkeypatch.setattr(coupons, "COUPONS", {
+        "GIAM10": Coupon("GIAM10", PERCENT, 10, max_discount=50000),
+        "BOT50K": Coupon("BOT50K", FIXED, 50000, min_order=200000),
+        "HETHAN": Coupon("HETHAN", FIXED, 10000, expires=date(2026, 11, 20)),
+        "HOMNAY": Coupon("HOMNAY", FIXED, 10000, expires=TODAY),
+        "TO": Coupon("TO", FIXED, 1000000),
+    })
+
+
+def make_order(price=100000, qty=2, code=None, province="HN"):
+    return Order("DH001", "Nguyễn Văn A", province,
+                 [OrderItem("SP1", "Áo thun", price, qty)], coupon_code=code)
+
+
+def test_no_coupon():
+    assert calc_discount(None, 200000) == 0
+
+
+def test_percent():
+    assert calc_discount("GIAM10", 200000, TODAY) == 20000
+
+
+def test_percent_capped():
+    assert calc_discount("GIAM10", 1000000, TODAY) == 50000
+
+
+def test_fixed():
+    assert calc_discount("BOT50K", 200000, TODAY) == 50000
+
+
+def test_code_case_insensitive():
+    assert calc_discount(" giam10 ", 200000, TODAY) == 20000
+
+
+def test_discount_not_exceed_subtotal():
+    assert calc_discount("TO", 200000, TODAY) == 200000
+
+
+def test_unknown_code():
+    with pytest.raises(ValueError, match="không tồn tại"):
+        calc_discount("XYZ", 200000, TODAY)
+
+
+def test_expired():
+    with pytest.raises(ValueError, match="hết hạn"):
+        calc_discount("HETHAN", 200000, TODAY)
+
+
+def test_valid_on_expiry_day():
+    assert calc_discount("HOMNAY", 200000, TODAY) == 10000
+
+
+def test_min_order():
+    with pytest.raises(ValueError, match="tối thiểu"):
+        calc_discount("BOT50K", 199999, TODAY)
+
+
+def test_total_vat_on_discounted_amount():
+    # 200k - 20k = 180k; VAT 14.4k; ship HN 20k
+    assert calc_total(make_order(code="GIAM10"), TODAY) == 180000 + 14400 + 20000
+
+
+def test_free_ship_threshold_after_discount():
+    # 550k - 50k = 500k -> không còn > 500k nên tính ship
+    o = make_order(price=275000, qty=2, code="BOT50K")
+    assert calc_total(o, TODAY) == 500000 + 40000 + 20000
+
+
+def test_free_ship_kept_when_still_above_threshold():
+    o = make_order(price=300000, qty=2, code="BOT50K")  # 600k - 50k = 550k
+    assert calc_total(o, TODAY) == 550000 + 44000
+
+
+def test_invoice_shows_discount():
+    out = render_invoice(make_order(code="giam10"), TODAY)
+    assert "Giảm giá (GIAM10): -20.000đ" in out
+    assert "VAT: 14.400đ" in out
+    assert "TỔNG: 214.400đ" in out
+
+
+def test_invoice_without_coupon_has_no_discount_line():
+    assert "Giảm giá" not in render_invoice(make_order(), TODAY)
