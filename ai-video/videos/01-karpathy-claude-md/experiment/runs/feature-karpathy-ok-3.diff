diff --git a/tests/test_discounts.py b/tests/test_discounts.py
new file mode 100644
index 0000000..c774f65
--- /dev/null
+++ b/tests/test_discounts.py
@@ -0,0 +1,52 @@
+import pytest
+
+from shop.models import Order, OrderItem
+from shop.discounts import calc_discount
+from shop.pricing import calc_total
+from shop.invoice import render_invoice
+
+
+def make_order(code=None, price=100000, qty=2):
+    return Order("DH003", "Lê Văn C", "HN", [OrderItem("SP1", "Áo thun", price, qty)], code)
+
+
+def test_no_code():
+    assert calc_discount(None, 200000) == 0
+
+
+def test_percent_code():
+    assert calc_discount("GIAM10", 200000) == 20000
+
+
+def test_fixed_code():
+    assert calc_discount("GIAM50K", 200000) == 50000
+
+
+def test_discount_capped_at_subtotal():
+    assert calc_discount("GIAM50K", 30000) == 30000
+
+
+def test_invalid_code():
+    with pytest.raises(ValueError):
+        calc_discount("KHONGCO", 200000)
+
+
+def test_total_with_discount_before_vat():
+    # 200.000 - 20.000 = 180.000; VAT 14.400; ship HN 20.000
+    assert calc_total(make_order("GIAM10")) == 180000 + 14400 + 20000
+
+
+def test_free_ship_uses_original_subtotal():
+    # tạm tính 600.000 > 500.000 -> miễn ship dù sau giảm còn 550.000
+    assert calc_total(make_order("GIAM50K", price=300000)) == 550000 + 44000
+
+
+def test_invoice_shows_discount():
+    out = render_invoice(make_order("GIAM10"))
+    assert "Giảm giá (GIAM10): -20.000đ" in out
+    assert "VAT: 14.400đ" in out
+    assert "TỔNG: 214.400đ" in out
+
+
+def test_invoice_without_discount_has_no_discount_line():
+    assert "Giảm giá" not in render_invoice(make_order())
