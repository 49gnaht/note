+# Mã giảm giá: mã -> (loại, giá trị). "percent": giảm theo %, "fixed": giảm số tiền VND.
+CODES = {
+    "GIAM10": ("percent", 10),
+    "GIAM50K": ("fixed", 50000),
+}
+
+
+def calc_discount(code, subtotal):
+    if code is None:
+        return 0
+    if code not in CODES:
+        raise ValueError(f"Mã giảm giá không hợp lệ: {code}")
+    kind, value = CODES[code]
+    if kind == "percent":
+        amount = int(round(subtotal * value / 100))
+    else:
+        amount = value
+    return min(amount, subtotal)
